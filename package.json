{
  "name": "concurrent-iteration",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phygon/concurrent-iteration.git"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "description": "Run asynchronous tasks over iterable values with optional bounded concurrency",
  "files": [
    "dist"
  ],
  "license": "0BSD",
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "tsdown": {
    "entry": ["./src/index.ts"],
    "outDir": "dist",
    "format": ["esm"],
    "dts": true,
    "sourcemap": true,
    "clean": true
  }
}
